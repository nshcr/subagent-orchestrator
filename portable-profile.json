{
  "format_version": 1,
  "profile_id": "efficient-user-controlled-subagent-orchestration-2026-08",
  "objective": [
    "correctness-and-user-control",
    "material-work-substitution",
    "bounded-context-isolation",
    "end-to-end-efficiency"
  ],
  "time_policy": "telemetry-only",
  "primary": {
    "model": "unconstrained",
    "reasoning_effort": "unconstrained",
    "owns": [
      "authorization",
      "scope",
      "single-writer-integration",
      "conflict-handling",
      "delegation-expansion-checkpoints",
      "original-outcome-acceptance-anchor",
      "final-acceptance"
    ]
  },
  "spawn_model_defaults": {
    "model_hint": "gpt-5.6-sol",
    "reasoning_effort_hint": "high"
  },
  "host_fallback": {
    "id": "default",
    "route": "primary-no-spawn",
    "explicit_agent_type_required": true,
    "fallback_result_route": "reject-and-primary-no-retry"
  },
  "builtin_routes": [
    {
      "id": "explorer",
      "topology": "leaf",
      "eligibility": "material narrow read-only codebase question whose focused scan replaces primary exploration"

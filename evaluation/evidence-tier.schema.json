{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/subagent-orchestrator/evaluation/evidence-tier.schema.json",
  "title": "Monotonic Evidence Tier",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tier", "revision", "package_digest", "artifact_digest", "predecessor", "provenance"],
  "properties": {
    "schema_version": {"const": "evidence-tier.v1"},
    "tier": {"enum": ["implemented", "verified-local", "verified-ci", "verified-target", "pilot-signed"]},
    "revision": {"type": "string", "minLength": 1},
    "package_digest": {"$ref": "#/$defs/sha256"},
    "artifact_digest": {"$ref": "#/$defs/sha256"},
    "predecessor": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "digest"],
          "properties": {
            "tier": {"enum": ["implemented", "verified-local", "verified-ci", "verified-target"]},
            "digest": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "provenance": {
      "oneOf": [
        {"$ref": "#/$defs/implemented"},
        {"$ref": "#/$defs/verifiedLocal"},
        {"$ref": "#/$defs/verifiedCi"},
        {"$ref": "#/$defs/verifiedTarget"},
        {"$ref": "#/$defs/pilotSigned"}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"tier": {"const": "implemented"}}}, "then": {"properties": {"predecessor": {"type": "null"}, "provenance": {"$ref": "#/$defs/implemented"}}}},
    {"if": {"properties": {"tier": {"const": "verified-local"}}}, "then": {"properties": {"provenance": {"$ref": "#/$defs/verifiedLocal"}}}},
    {"if": {"properties": {"tier": {"const": "verified-ci"}}}, "then": {"properties": {"provenance": {"$ref": "#/$defs/verifiedCi"}}}},
    {"if": {"properties": {"tier": {"const": "verified-target"}}}, "then": {"properties": {"provenance": {"$ref": "#/$defs/verifiedTarget"}}}},
    {"if": {"properties": {"tier": {"const": "pilot-signed"}}}, "then": {"properties": {"provenance": {"$ref": "#/$defs/pilotSigned"}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "string": {"type": "string", "minLength": 1},
    "implemented": {
      "type": "object", "additionalProperties": false,
      "required": ["source_tree_sha256", "diff_sha256", "implementation_receipt_sha256"],
      "properties": {"source_tree_sha256": {"$ref": "#/$defs/sha256"}, "diff_sha256": {"$ref": "#/$defs/sha256"}, "implementation_receipt_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "verifiedLocal": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "exit_code", "environment_sha256", "result_sha256"],
      "properties": {"command": {"$ref": "#/$defs/string"}, "exit_code": {"const": 0}, "environment_sha256": {"$ref": "#/$defs/sha256"}, "result_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "verifiedCi": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "run_id", "run_url", "revision", "result_sha256"],
      "properties": {"provider": {"$ref": "#/$defs/string"}, "run_id": {"$ref": "#/$defs/string"}, "run_url": {"$ref": "#/$defs/string"}, "revision": {"$ref": "#/$defs/string"}, "result_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "verifiedTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "environment_sha256", "revision", "package_digest", "receipt_sha256"],
      "properties": {"target_id": {"$ref": "#/$defs/string"}, "environment_sha256": {"$ref": "#/$defs/sha256"}, "revision": {"$ref": "#/$defs/string"}, "package_digest": {"$ref": "#/$defs/sha256"}, "receipt_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "pilotSigned": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "authority_id", "signed_at", "signature_sha256", "target_receipt_sha256"],
      "properties": {"authority": {"$ref": "#/$defs/string"}, "authority_id": {"$ref": "#/$defs/string"}, "signed_at": {"$ref": "#/$defs/string"}, "signature_sha256": {"$ref": "#/$defs/sha256"}, "target_receipt_sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}

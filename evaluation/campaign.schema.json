{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/subagent-orchestrator/evaluation/campaign.schema.json",
  "title": "Subagent Orchestrator Evaluation Campaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "configuration_hashes", "allowed_baseline_roles", "class_policies", "execution_order", "instances"],
  "properties": {
    "schema_version": {"const": 3},
    "campaign_id": {"$ref": "#/$defs/string"},
    "configuration_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_instructions", "routing_policy", "task_fixtures", "graders", "grader_execution_authority_receipt", "pricing"],
      "properties": {
        "role_instructions": {"$ref": "#/$defs/sha256"},
        "routing_policy": {"$ref": "#/$defs/sha256"},
        "task_fixtures": {"$ref": "#/$defs/sha256"},
        "graders": {"$ref": "#/$defs/sha256"},
        "grader_execution_authority_receipt": {"$ref": "#/$defs/sha256"},
        "pricing": {"$ref": "#/$defs/sha256"}
      }
    },
    "allowed_baseline_roles": {"$ref": "#/$defs/stringList"},
    "class_policies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/classPolicy"}
    },
    "execution_order": {"$ref": "#/$defs/executionOrder"},
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/instance"},
          {"properties": {"holdout": {"const": false}}}
        ]
      }
    }
  },
  "$defs": {
    "string": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "stringList": {"type": "array", "items": {"$ref": "#/$defs/string"}, "uniqueItems": true},
    "classPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision_mode", "custom_role"],
          "properties": {
            "decision_mode": {"const": "elective"},
            "custom_role": {"$ref": "#/$defs/string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision_mode", "custom_role", "higher_level_required", "callable_builtin_equivalent", "availability_probe_reference", "availability_probe_sha256", "restored_after_probe"],
          "properties": {
            "decision_mode": {"const": "mandatory_named_gate"},
            "custom_role": {"$ref": "#/$defs/string"},
            "higher_level_required": {"const": true},
            "callable_builtin_equivalent": {"const": false},
            "availability_probe_reference": {"$ref": "#/$defs/string"},
            "availability_probe_sha256": {"$ref": "#/$defs/sha256"},
            "restored_after_probe": {"const": true}
          }
        }
      ]
    },
    "executionOrder": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instance_id", "arm"],
        "properties": {
          "instance_id": {"$ref": "#/$defs/string"},
          "arm": {"enum": ["baseline", "custom"]}
        }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "task_class", "fixture_family", "fixture_sha256", "prompt_sha256", "rubric_sha256", "scenario", "expected_roles", "holdout", "arm_order", "runs"],
      "properties": {
        "instance_id": {"$ref": "#/$defs/string"},
        "task_class": {"$ref": "#/$defs/string"},
        "fixture_family": {"$ref": "#/$defs/string"},
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "rubric_sha256": {"$ref": "#/$defs/sha256"},
        "scenario": {"$ref": "#/$defs/string"},
        "expected_roles": {"$ref": "#/$defs/stringList"},
        "holdout": {"type": "boolean"},
        "arm_order": {"oneOf": [{"const": ["baseline", "custom"]}, {"const": ["custom", "baseline"]}]},
        "runs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "custom"],
          "properties": {
            "baseline": {"$ref": "#/$defs/run"},
            "custom": {"$ref": "#/$defs/run"}
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threads", "expected_thread_ids", "expected_receiver_ids", "process_exit_code", "completion_status", "execution_index", "wall_time_ms", "child_count", "retries", "quality_checks", "scope_violations", "routing_violations", "routing_decision", "grader_sha256", "contamination_audit"],
      "properties": {
        "threads": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/thread"}},
        "expected_thread_ids": {"$ref": "#/$defs/stringList"},
        "expected_receiver_ids": {"$ref": "#/$defs/stringList"},
        "process_exit_code": {"type": "integer"},
        "completion_status": {"enum": ["completed", "failed", "cancelled"]},
        "execution_index": {"type": "integer", "minimum": 0},
        "wall_time_ms": {"type": "integer", "minimum": 0},
        "child_count": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "quality_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "scope_violations": {"$ref": "#/$defs/stringList"},
        "routing_violations": {"$ref": "#/$defs/stringList"},
        "routing_decision": {"$ref": "#/$defs/string"},
        "grader_sha256": {"$ref": "#/$defs/sha256"},
        "contamination_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "notes"],
          "properties": {"passed": {"type": "boolean"}, "notes": {"type": "string"}}
        }
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "kind", "attempt", "status", "role", "parent_thread_id", "terminal", "cost_complete", "model", "effort", "service_tier", "tokens", "credits"],
      "properties": {
        "thread_id": {"$ref": "#/$defs/string"},
        "kind": {"enum": ["primary", "child"]},
        "attempt": {"type": "integer", "minimum": 1},
        "status": {"enum": ["completed", "failed", "cancelled"]},
        "role": {"$ref": "#/$defs/string"},
        "parent_thread_id": {"type": ["string", "null"]},
        "terminal": {"type": "boolean"},
        "cost_complete": {"type": "boolean"},
        "model": {"$ref": "#/$defs/string"},
        "effort": {"$ref": "#/$defs/string"},
        "service_tier": {"const": "default"},
        "tokens": {"$ref": "#/$defs/tokens"},
        "credits": {"$ref": "#/$defs/credits"}
      },
      "allOf": [
        {
          "if": {"properties": {"cost_complete": {"const": true}}},
          "then": {"properties": {"credits": {"$ref": "#/$defs/exactCredits"}}},
          "else": {"properties": {"credits": {"$ref": "#/$defs/unavailableCredits"}}}
        }
      ]
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "cache_write_input_tokens", "output_tokens", "reasoning_output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "cache_write_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "credits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncached_input", "cached_input", "output", "total"],
      "properties": {
        "uncached_input": {"oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "cached_input": {"oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "output": {"oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "total": {"oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]}
      }
    },
    "exactCredits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncached_input", "cached_input", "output", "total"],
      "properties": {
        "uncached_input": {"$ref": "#/$defs/decimal"}, "cached_input": {"$ref": "#/$defs/decimal"},
        "output": {"$ref": "#/$defs/decimal"}, "total": {"$ref": "#/$defs/decimal"}
      }
    },
    "unavailableCredits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncached_input", "cached_input", "output", "total"],
      "properties": {
        "uncached_input": {"type": "null"}, "cached_input": {"type": "null"},
        "output": {"type": "null"}, "total": {"type": "null"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "passed", "critical", "score", "max_score", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/string"},
        "passed": {"type": "boolean"},
        "critical": {"type": "boolean"},
        "score": {"type": "integer", "minimum": 0},
        "max_score": {"type": "integer", "minimum": 1},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "artifact_sha256", "artifact_source_id", "grader_execution"],
          "properties": {
            "kind": {"enum": ["behavior", "source-fact"]},
            "artifact_sha256": {"$ref": "#/$defs/sha256"},
            "artifact_source_id": {"$ref": "#/$defs/string"},
            "grader_execution": {
              "type": "object",
              "additionalProperties": false,
              "required": ["receipt_sha256", "authority_receipt_sha256", "grader_sha256", "evidence_artifact_sha256", "artifact_source_id", "result_sha256", "exit_code"],
              "properties": {
                "receipt_sha256": {"$ref": "#/$defs/sha256"},
                "authority_receipt_sha256": {"$ref": "#/$defs/sha256"},
                "grader_sha256": {"$ref": "#/$defs/sha256"},
                "evidence_artifact_sha256": {"$ref": "#/$defs/sha256"},
                "artifact_source_id": {"$ref": "#/$defs/string"},
                "result_sha256": {"$ref": "#/$defs/sha256"},
                "exit_code": {"const": 0}
              }
            }
          }
        }
      }
    }
  }
}
